*.pt
*.pth
*.ckpt
*.safetensors
*.onnx
*.onnx.data
*.bin
*.npy
*.npz
training_data/
tmp/

# Worktrees — managed by git, not source
workspace/worktrees/
workspace/builds/
workspace/caches/
workspace/tmp/
workspace/evidence/
workspace/review/

# Local model/artifact directories — keep manifests and code, not model weights.
**/artifacts/models/

