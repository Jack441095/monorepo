# Copy to .env for local development. Never commit the real .env (see
# root .gitignore's `.env` / `.env.*` / `!.env.example` rules).

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://localhost/nitedsp_staging

NITE_DSP_PUBLIC_URL=http://localhost:3000
NITE_DSP_API_URL=http://localhost:8000
NITE_DSP_SUPPORT_EMAIL=nitedsp@outlook.com

SESSION_SECRET=change-me-to-a-real-random-value

# Stripe Checkout and webhook signing use separate dashboard credentials.
# Staging requires sk_test_/rk_test_; production requires sk_live_/rk_live_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRODUCT_ID=nite-submit
STRIPE_INTRO_PRICE_ID=
STRIPE_REGULAR_PRICE_ID=
STRIPE_ACTIVE_PRICE_ID=
STRIPE_CHECKOUT_ENABLED=0

# Independent paid-launch gates. Production checkout refuses to start while
# either is false. Set only after the signed review/release receipts exist.
LEGAL_REVIEW_APPROVED=0
RELEASE_READY=0

# Staging rehearsal uses Stripe test prices and public HTTPS app/API URLs.
STAGING_CUSTOMER_REHEARSAL=0

# console is allowed only for non-customer staging proofs. A customer
# rehearsal requires EMAIL_PROVIDER=resend, RESEND_API_KEY, and a real sender
# address; the localhost placeholder is rejected by the staging validator.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=NITE DSP
EMAIL_FROM_ADDRESS=noreply@localhost.invalid
RESEND_API_KEY=

# Licensing -- generate via scripts/generate_staging_keypair.py for local/staging.
# Production keys are generated directly in the production environment and
# never touch this file -- see docs/LICENSE_KEY_LIFECYCLE.md.
LICENSING_PRIVATE_KEY_PATH=./staging_keys/licensing_signing_key.private
LICENSING_PUBLIC_KEY_PATH=./staging_keys/licensing_signing_key.public
SUBMIT_LICENSE_PRIVATE_KEY_BASE64=

MOCK_STORAGE_DIR=./mock_storage

# Durable release storage. Keep local for development/tests. For staging or
# production, use an owner-controlled private S3-compatible bucket such as
# Cloudflare R2 and set all fields below in the provider secret store.
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Fail-closed by design -- see docs/SECURITY_MODEL.md. Empty means every
# admin endpoint is entirely unreachable.
ADMIN_API_KEY=
