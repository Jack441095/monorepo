# Copy to .env for local development. Never commit the real .env (see
# root .gitignore's `.env` / `.env.*` / `!.env.example` rules).

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://localhost/nitedsp_staging

NITE_DSP_PUBLIC_URL=http://localhost:3000
NITE_DSP_API_URL=http://localhost:8000
NITE_DSP_SUPPORT_EMAIL=nitedsp@outlook.com

SESSION_SECRET=change-me-to-a-real-random-value

# Paddle sandbox -- leave blank until a real Paddle sandbox account exists
# (docs/HUMAN_COMMERCIAL_REQUIREMENTS.md). PADDLE_WEBHOOK_SECRET can be set
# to any local test value to exercise the webhook signature-verification
# code path against self-signed simulated payloads even before a real
# account exists -- see tests/test_e2e.py.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# sandbox-api.paddle.com until a human explicitly flips this to
# api.paddle.com for a real production deploy. Never inferred from ENVIRONMENT.
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com

# Sandbox catalog mapping for NITE Submit only. These are Paddle catalog
# identifiers, not credentials. Replace the placeholders with the owner-
# confirmed Submit Sandbox IDs in the uncommitted staging secret store. Do
# not copy SLO/Smart Sample Manager IDs into a Submit environment.
PADDLE_PRODUCT_ID=pro_submit_sandbox
PADDLE_INTRO_PRICE_ID=
PADDLE_REGULAR_PRICE_ID=pri_submit_sandbox

# Which of the two price IDs above checkout currently offers -- an explicit
# owner-controlled switch (Section 18/67), not automatic based on a date.
PADDLE_ACTIVE_PRICE_ID=pri_submit_sandbox

# Backend checkout request gate. Keep disabled until the owner explicitly
# approves checkout for this environment. Staging sandbox rehearsal may set
# this to 1; production must remain 0 until live catalog/webhook validation
# and the final checkout approval are complete.
PADDLE_CHECKOUT_ENABLED=0

# Independent paid-launch gates. Production checkout refuses to start while
# either is false. Set only after the signed review/release receipts exist.
LEGAL_REVIEW_APPROVED=0
RELEASE_READY=0

# Staging go/no-go: set ENVIRONMENT=staging only with owner-confirmed NITE
# Submit Sandbox catalog IDs, a pdl_sdbx_ API key, a real webhook secret, and
# public HTTPS NITE_DSP_PUBLIC_URL/NITE_DSP_API_URL values. The staging startup
# validator refuses live Paddle keys/URLs, incomplete catalog credentials, and
# localhost/http origins. Do not copy the SLO identifiers above into a Submit
# staging environment without confirming the Paddle catalog item.
STAGING_CUSTOMER_REHEARSAL=0

# console is allowed only for non-customer staging proofs. A customer
# rehearsal requires EMAIL_PROVIDER=resend, RESEND_API_KEY, and a real sender
# address; the localhost placeholder is rejected by the staging validator.
EMAIL_PROVIDER=console
EMAIL_FROM_NAME=NITE DSP
EMAIL_FROM_ADDRESS=noreply@localhost.invalid
RESEND_API_KEY=

# Licensing -- generate via scripts/generate_staging_keypair.py for local/staging.
# Production keys are generated directly in the production environment and
# never touch this file -- see docs/LICENSE_KEY_LIFECYCLE.md.
LICENSING_PRIVATE_KEY_PATH=./staging_keys/licensing_signing_key.private
LICENSING_PUBLIC_KEY_PATH=./staging_keys/licensing_signing_key.public

MOCK_STORAGE_DIR=./mock_storage

# Durable release storage. Keep local for development/tests. For staging or
# production, use an owner-controlled private S3-compatible bucket such as
# Cloudflare R2 and set all fields below in the provider secret store.
STORAGE_BACKEND=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Fail-closed by design -- see docs/SECURITY_MODEL.md. Empty means every
# admin endpoint is entirely unreachable.
ADMIN_API_KEY=
