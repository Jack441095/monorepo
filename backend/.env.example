# Copy to .env for local development. Never commit the real .env (see
# root .gitignore's `.env` / `.env.*` / `!.env.example` rules).

ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg2://localhost/nitedsp_staging

NITE_DSP_PUBLIC_URL=http://localhost:3000
NITE_DSP_API_URL=http://localhost:8000
NITE_DSP_SUPPORT_EMAIL=support@localhost.invalid

SESSION_SECRET=change-me-to-a-real-random-value

# Paddle sandbox -- leave blank until a real Paddle sandbox account exists
# (docs/HUMAN_COMMERCIAL_REQUIREMENTS.md). PADDLE_WEBHOOK_SECRET can be set
# to any local test value to exercise the webhook signature-verification
# code path against self-signed simulated payloads even before a real
# account exists -- see tests/test_e2e.py.
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# sandbox-api.paddle.com until a human explicitly flips this to
# api.paddle.com for a real production deploy. Never inferred from ENVIRONMENT.
PADDLE_API_BASE_URL=https://sandbox-api.paddle.com

# Sandbox catalog mapping for SLO / Smart Sample Manager. These are Paddle
# catalog identifiers, not credentials. Keep API and webhook secrets in an
# uncommitted .env file only.
PADDLE_PRODUCT_ID=pro_01kzyq7zeefn42h5f6kewcr70k
PADDLE_INTRO_PRICE_ID=pri_01kzyq803he33tp22td81w4f3
PADDLE_REGULAR_PRICE_ID=pri_01kzyq80by1ta9mnpjekpfcb8g

# Which of the two price IDs above checkout currently offers -- an explicit
# owner-controlled switch (Section 18/67), not automatic based on a date.
PADDLE_ACTIVE_PRICE_ID=pri_01kzyq80by1ta9mnpjekpfcb8g

EMAIL_PROVIDER=console
EMAIL_FROM_NAME=NITE DSP
EMAIL_FROM_ADDRESS=noreply@localhost.invalid

# Licensing -- generate via scripts/generate_staging_keypair.py for local/staging.
# Production keys are generated directly in the production environment and
# never touch this file -- see docs/LICENSE_KEY_LIFECYCLE.md.
LICENSING_PRIVATE_KEY_PATH=./staging_keys/licensing_signing_key.private
LICENSING_PUBLIC_KEY_PATH=./staging_keys/licensing_signing_key.public

MOCK_STORAGE_DIR=./mock_storage

# Fail-closed by design -- see docs/SECURITY_MODEL.md. Empty means every
# admin endpoint is entirely unreachable.
ADMIN_API_KEY=
