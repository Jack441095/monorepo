_RUNTIME = None  # Lazy-initialized SubagentRuntime singleton
_INPROCESS = os.environ.get("AUDIO_TOO_INPROCESS_AGENTS", "").strip() == "1"


def _ensure_runtime():
    """Lazy-init the SubagentRuntime and register agent entry points."""
    global _RUNTIME
    if _RUNTIME is not None:
        return _RUNTIME

    from thursday.subagent_runtime import SubagentRuntime, register_agent

    # Register Admin
    try:
        admin_path = ROOT / "Admin"
        if str(admin_path) not in sys.path:
            sys.path.insert(0, str(admin_path))
        from local_agent import execute as admin_execute
        register_agent("Admin", admin_execute)
    except ImportError:
        pass

    # Register Marketing
    try:
        mkt_path = ROOT / "Marketing"
        if str(mkt_path) not in sys.path:
            sys.path.insert(0, str(mkt_path))
        from Marketing.main import execute as marketing_execute
        register_agent("Marketing", marketing_execute)
    except ImportError:
        pass

    # Register Research
    try:
        from Research.main import execute as research_execute
        register_agent("Research", research_execute)
    except ImportError:
        pass

    _RUNTIME = SubagentRuntime(
        max_workers=4,
        default_timeout=120.0,
        repo_root=REPO_ROOT,
    )
    return _RUNTIME


