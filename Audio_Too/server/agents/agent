def interactive() -> int:
    print("Audio_Too local agents")
    print("Choose: admin, marketing, ask, or quit")

    while True:
        choice = input("\nAgent> ").strip().lower()
        if choice in {"q", "quit", "exit"}:
            return 0
        if choice in {"help", "h", "?"}:
            print_help()
            continue
        if choice not in {"admin", "marketing", "ask"}:
            print("Choose admin, marketing, ask, or quit.")
            continue

        task = input("Task> ").strip()
        if not task:
            print("No task provided.")
            continue

        if choice == "ask":
            folder, routed_args = route_request(task)
            print(f"\nRouting to {folder}...\n")
            run_agent(folder, routed_args)
        elif choice == "admin":
            run_agent("Admin", task.split())
        else:
            run_agent("Marketing", task.split())


