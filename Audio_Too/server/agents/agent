def set_draft_status(draft_id: str, status: str) -> str:
    record = update_record("drafts", draft_id, {"status": status}, ["recipient", "subject"])
    if not record:
        return f"Draft not found: {draft_id}"
    label = record.get("subject") or record.get("recipient") or "Untitled"
    return f"{status} draft {record.get('id')}: {label}"


def due_items(overdue_only: bool = False) -> str:
    title = "Overdue Work" if overdue_only else "Due Work"
    items = collect_due_items(list_records, overdue_only=overdue_only)
    return title + "\n\n" + format_table(items, ["type", "id", "name", "due", "next_action"], "No matching due items.")


def invoice_export_dir() -> Path:
    return ROOT / "Shared" / "exports" / "invoices"


def find_invoice(identifier: str) -> dict | None:
    needle = identifier.strip().lower()
    for invoice in list_records("invoices"):
        values = [str(invoice.get("id", "")), str(invoice.get("client", "")), str(invoice.get("service", ""))]
        if any(value.lower() == needle for value in values):
            return invoice
    return None


def export_invoice_pdf(identifier: str) -> str:
    invoice = find_invoice(identifier)
    if not invoice:
        return f"Invoice not found: {identifier}"
    path = write_invoice_pdf(invoice, invoice_export_dir())
    return f"Exported invoice PDF: {path}"


def export_invoice_pdfs() -> str:
    invoices = list_records("invoices")
    if not invoices:
        return "No invoices found."
    paths = [write_invoice_pdf(invoice, invoice_export_dir()) for invoice in invoices]
    return "Exported invoice PDFs:\n" + "\n".join(f"- {path}" for path in paths)


