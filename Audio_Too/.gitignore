# Thursday runtime state now defaults outside the repository (see
# docs/THURSDAY_RUNTIME_STATE.md). These rules protect upgraded legacy
# installs and explicit overrides that still point at the old directories.

# --- SHARED ---

# Local AudioGen dashboard runtime state
data/audiogen_render_queue.json
data/audiogen_render_history.json
data/audio_queries/
data/artifacts/
data/creative_lab_sessions.json

# Scan/benchmark analysis outputs — regenerable
artifacts/

# Test fixture artifacts
tmp_pytest/

# Transient root files
tmp/
.claude/worktrees/

# Build artifacts (macOS app bundle / dmg from scripts/build_mac_app.py)
/dist/
/out/

# One-off SQLite backups (e.g. before a data cleanup) — never committed
data/*.db.bak*

# Native DSP kernel build artifacts (platform/arch-specific, built on demand)
studio/audio_analysis/audio_analysis/dsp_engine/native/*.dylib
studio/audio_analysis/audio_analysis/dsp_engine/native/*.so

# VST3 plugin CMake build output (compiled binaries + vendored deps, not source)
studio/vst3_plugins/*/build/
studio/vst3_plugins/*/build-release/
studio/vst3_plugins/*/build-arm64/
# Catches every one-off build dir created by recovery/validation phases
# (build-phase85, build-recovery-r1, build-canonical-integration, etc.)
studio/vst3_plugins/*/build-*/

# Packaged release installers (built artifacts, not source)
studio/vst3_plugins/*/*.dmg

# KENNMixAssistant CMake build output (root-level build dir, same rule as above)
/build/

# NITE DSP website: Next.js build output and npm deps -- regenerable, not source
nitedsp/website/.next/
nitedsp/website/node_modules/

# Licensing dev/test server: the Ed25519 private signing key must never be
# committed (production uses a separate keypair generated on the real
# backend anyway -- this one only signs local test licenses), and the local
# SQLite license/activation database is generated test data, not source.
studio/vst3_plugins/SmartSampleManager/licensing_server/keys/
studio/vst3_plugins/SmartSampleManager/licensing_server/licensing.db
studio/vst3_plugins/SmartSampleManager/licensing_server/licensing.db-wal
studio/vst3_plugins/SmartSampleManager/licensing_server/licensing.db-shm

# NITE DSP backend: same rule as the dev licensing server above -- the
# staging Ed25519 private key must never be committed either.
nitedsp/backend/staging_keys/

# NITE DSP backend: local mock storage standing in for real release-artifact
# hosting during staging -- generated/placeholder test data, not source.
nitedsp/backend/mock_storage/

# Model export intermediates: the downloaded checkpoint is reproducible via
# model_export/README.md's curl command and shouldn't bloat the repo with a
# 25MB file; the exported .onnx/.onnx.data are committed under Models/
# instead (the canonical shipped location), not duplicated here.
studio/vst3_plugins/SmartSampleManager/model_export/*.pth
studio/vst3_plugins/SmartSampleManager/model_export/*.onnx
studio/vst3_plugins/SmartSampleManager/model_export/*.onnx.data

# Internal docs and planning documents — not part of the public/work repo
docs/

# Never committed: contains passport number / personal address
LICENSE_SHENRENDAO.md

# Runtime caches, model caches, and personal data dumps — not source
data/coreml_cache/
server/data/
sample_pack_testing/
studio/kenn/kenn/data/*.db
