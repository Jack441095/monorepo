# Copy to .env (not committed) for local overrides.
#
# Full reference of every environment variable read anywhere in this repo
# (audited 2026-07-13 — see docs/codebase_scan_12_07.md §4.4 "config sprawl").
# Only the values above the "Advanced / rarely changed" marker in each
# section need attention for a normal local setup; everything below it has
# a sane default and exists for tuning/CI/edge cases.

# ── Dashboard auth & sessions ────────────────────────────────────────────
AUDIO_TOO_DASHBOARD_PASSWORD=change-me
AUDIO_TOO_NOTIFY=1
# Set to 1 only for local dev if you have not changed the password yet.
AUDIO_TOO_DEV=0
# Required outside development mode; generate a dedicated 32+ character random value.
AUDIO_TOO_SESSION_SECRET=replace-with-a-long-random-session-secret
# Enable only when the dashboard is served through HTTPS.
AUDIO_TOO_COOKIE_SECURE=0
# KENN chat sessions older than this are removed when KENN starts.
AUDIO_TOO_KENN_SESSION_RETENTION_HOURS=168
# Comma-separated CORS allow-list for the dashboard's own API (business/app/server.py).
# AUDIO_TOO_ALLOWED_ORIGINS=http://127.0.0.1:8080
# Dashboard host/port (business/app/server_config.py). Defaults shown.
# AUDIO_TOO_HOST=127.0.0.1
# AUDIO_TOO_PORT=8080
# Retention window (days) for old runtime artifacts (business/app/retention.py). Default 30.
# AUDIO_TOO_RETENTION_DAYS=30

# ── External/local-system action gates ───────────────────────────────────
# Each is disabled unless explicitly reviewed and enabled — see scripts/action_policy.py.
AUDIO_TOO_ALLOW_EXTERNAL_EMAIL=0
AUDIO_TOO_ALLOW_DESKTOP_AUTOMATION=0
AUDIO_TOO_ALLOW_DAW_CONTROL=0
AUDIO_TOO_ALLOW_AUDIO_CAPTURE=0

# ── Signed link keys (upload/invoice) ────────────────────────────────────
# SECURITY: each falls back to AUDIO_TOO_DASHBOARD_PASSWORD as its HMAC key
# if left unset (business/app/upload_tokens.py, invoice_tokens.py). Set
# distinct random values in any real deployment — see docs/codebase_scan_12_07.md
# §4.1 "signing key reused across trust boundaries".
# AUDIO_TOO_UPLOAD_SIGNING_KEY=long-random-string
# AUDIO_TOO_INVOICE_SIGNING_KEY=long-random-string

# ── Email on new enquiry (optional — uses SMTP; no email sent if host/TO are empty) ──
AUDIO_TOO_EMAIL_ENABLED=1
AUDIO_TOO_SMTP_HOST=smtp.office365.com
AUDIO_TOO_SMTP_PORT=587
AUDIO_TOO_SMTP_USER=audio_too@outlook.com
AUDIO_TOO_SMTP_PASSWORD=your-app-password-here
AUDIO_TOO_EMAIL_FROM=audio_too@outlook.com
AUDIO_TOO_EMAIL_TO=audio_too@outlook.com
# AUDIO_TOO_EMAIL_DEBUG=1

# ── Optional external tester demo for Audio Tips LLM (/demo) ────────────
# Testers get this password only; it does not unlock the dashboard.
# AUDIO_TOO_DEMO_PASSWORD=demo-password-for-testers
# AUDIO_TOO_DEMO_SESSION_SECRET=another-long-random-string
# AUDIO_TOO_DEMO_HOST=127.0.0.1
# AUDIO_TOO_DEMO_PORT=8091

# ── Optional LLM rewrite (retrieval-first: notes are searched, then an LLM polishes the answer) ──
# AUDIO_TOO_LLM_ENABLED=1
# AUDIO_TOO_LLM_API_KEY=sk-your-openai-key
# AUDIO_TOO_LLM_MODEL=gpt-4o-mini
# AUDIO_TOO_LLM_BASE_URL=https://api.openai.com/v1

# OX ALPHA via TokenRa (OpenAI-compatible gateway). Activate by setting the
# same 4 vars below (PROVIDER=openai). Base URL is tokenra.io/v1 -- NOT
# api.tokenra.io (that subdomain does not resolve). Model is stealth/ox-alpha.
# Insert your real key in your local, gitignored .env -- never here.
# AUDIO_TOO_LLM_ENABLED=1
# AUDIO_TOO_LLM_PROVIDER=openai
# AUDIO_TOO_LLM_MODEL=stealth/ox-alpha
# AUDIO_TOO_LLM_BASE_URL=https://tokenra.io/v1
# AUDIO_TOO_LLM_API_KEY=sk-your-tokenra-key

# Local Ollama (no API key):
# AUDIO_TOO_LLM_ENABLED=1
# AUDIO_TOO_LLM_PROVIDER=ollama
# AUDIO_TOO_LLM_MODEL=llama3.2
# AUDIO_TOO_LLM_BASE_URL=http://127.0.0.1:11434/v1

# Advanced / rarely changed — per-purpose model overrides and timeouts
# (audio_too/model_runtime.py, thursday/brain.py, studio/kenn/kenn/llm/llm_rewrite.py,
# business/agents/Shared/*). Defaults shown.
# AUDIO_TOO_LLM_MODEL_ROUTE=qwen2.5:1.5b   # Thursday's routing/decide-what-to-do model
# AUDIO_TOO_LLM_MODEL_VOICE=               # optional distinct model when voice mode is active
# AUDIO_TOO_LLM_MODEL_REWRITE=             # set automatically from *_VOICE during a voice turn
# AUDIO_TOO_LLM_TIMEOUT=90                 # seconds; thursday/brain.py itself defaults to 10
# AUDIO_TOO_MIX_REVIEW_LLM=0               # 1 enables the optional LLM mix-review critique pass
# MIX_REVIEW_CRITIQUE_ENABLED=0            # gate actually read inside mix_review_critique.py

# ── Thursday orchestrator (HTTP server + agent runtime) ──────────────────
# The auth secret for thursday/server.py's HTTP API. Falls back to
# AUDIO_TOO_DASHBOARD_PASSWORD if unset; the server refuses to start with
# neither set (outside AUDIO_TOO_DEV=1). Set a distinct value in production.
# THURSDAY_SERVER_TOKEN=replace-with-a-long-random-token
# THURSDAY_SERVER_PORT=8092
# HMAC secret for confirmation-flow tokens (thursday/confirmation.py). Falls
# back to a weaker default if unset — set a distinct value in production.
# THURSDAY_CONFIRMATION_SECRET=replace-with-a-long-random-secret
# Gates Thursday's Stage-8 LLM brain/reasoning path (thursday/orchestrator.py).
# Currently a no-op if enabled — see docs/codebase_scan_12_07.md §2.1.
# THURSDAY_BRAIN_ENABLED=0
# Gates autonomous email sending in business/agents/Shared/draft_sender.py.
# AUDIO_TOO_AUTONOMOUS=0
# How often (minutes) Thursday's proactive checks (overdue invoices, expiring
# links, etc.) run — only fires inline on an incoming request, see
# docs/codebase_scan_12_07.md §4.4. Default 30.
# THURSDAY_CHECK_INTERVAL_MINUTES=30
# Speak streaming partial replies instead of waiting for the full answer
# (thursday/voice.py). Default on.
# THURSDAY_STREAMING_VOICE=1

# Advanced / rarely changed — Thursday runtime data locations. All default
# to sensible paths under thursday/; only needed for a non-standard layout
# or to isolate test/staging state (see tests/conftest.py for the pattern).
# THURSDAY_DATA_DIR=
# THURSDAY_PROFILE_DIR=
# THURSDAY_ANALYTICS_DIR=
# THURSDAY_ALERTS_DIR=
# THURSDAY_SESSION_DIR=
# THURSDAY_SESSION_FILE=
# THURSDAY_CALENDAR_DIR=
# THURSDAY_PLAN_MEMORY_DB=
# THURSDAY_PLAN_MEMORY_ARCHIVE=
# THURSDAY_ACTION_RECEIPTS_DB=

# ── KENN (RAG chat server) ────────────────────────────────────────────────
# KENN_HOST=127.0.0.1
# KENN_PORT=8090
# Comma-separated CORS allow-list for KENN's own API (studio/kenn/kenn/server.py).
# KENN_ALLOWED_ORIGINS=http://127.0.0.1:8090
# Flagship fine-tuned local-LLM answer path — trained but grounding is not
# yet solved, deliberately left off. See docs/codebase_scan_12_07.md §2.1.
# KENN_LM_ENABLED=0
# Optional self-critique/reflection LLM passes (studio/kenn/kenn/knowledge/reflection.py).
# KENN_CRITIQUE_LLM_ENABLED=0
# Optional trained reranker model (studio/kenn/kenn/retrieval/retrieval.py). Off by default.
# KENN_RERANKER_MODEL_ENABLED=0

# Advanced / rarely changed
# KENN_DB_PATH=                          # defaults under KENN_CHATS_DIR
# KENN_CHATS_DIR=                        # defaults to studio/kenn/kenn/chats
# KENN_SESSION_FILE=                     # defaults under KENN_CHATS_DIR
# KENN_LLM_CACHE=1                       # cache LLM-rewritten answers in-process
# KENN_LLM_CACHE_MAX=512                 # max cached entries
# KENN_LLM_CACHE_TTL=86400               # cache entry lifetime, seconds (24h)
# KENN_MAX_CONTRADICTIONS=50             # cap on contradiction pairs surfaced per index build
# KENN_OLLAMA_KEEP_ALIVE=30m             # native /api/generate keep_alive ping interval
# KENN_SUBPROCESS_FALLBACK=0             # business/agents' kenn_client.py: force subprocess mode
# OLLAMA_HOST=http://localhost:11434     # shared by KENN and the business agents' LLM client

# ── AutoMix / AudioGen job runtime ────────────────────────────────────────
# AUTOMIX_JOB_TIMEOUT_SECONDS=600
# AUDIOGEN_DEFAULT_PRESET=
# AUDIOGEN_PRESET_DIR=
# AUDIOGEN_DISABLE_VOICE_LEADING=0
# AUDIOGEN_HEADLESS=0                    # skip real CoreAudio device I/O (used by CI/tests)
# AUDIOGEN_PERF_MODE=                    # "high" forced by system_full_audit.py; else CONFIG default
# AUDIOGEN_RT_PROFILE=0                  # enable the realtime render profiler
# AUDIOGEN_RT_BAR_LOG=0
# AUDIOGEN_RT_CPROFILE_TOPN=25
# AUDIOGEN_RT_PROFILE_SLOW_RATIO=0.85
# LLM_AUDIOGEN_DISABLE_NUMBA_REVERB=0

# ── Business agents (CodingAgent / Admin / Marketing) ────────────────────
# AUDIO_TOO_AGENT_MODEL=qwen2.5-coder:7b
# AUDIO_TOO_AGENT_FAST_MODEL=qwen2.5-coder:1.5b

# ── Third-party library tuning (set by code, not usually by you) ─────────
# These are set via os.environ.setdefault() at import time as workarounds
# for OpenMP/numba behavior on this project's hardware — listed here for
# completeness, not something you normally need to set yourself.
# KMP_DUPLICATE_LIB_OK=TRUE
# NUMBA_CACHE_DIR=

# ── Native-Python / venv path overrides (advanced, non-standard setups only) ──
# Used to point at the native arm64 interpreter instead of the (possibly
# Rosetta x86_64) repo .venv — see docs/codebase_scan_12_07.md project memory
# on this machine's venv split. Leave unset unless you know you need this.
# AUDIO_TOO_NATIVE_PYTHON=
# AUDIO_TOO_WEBSITE_PYTHON=
