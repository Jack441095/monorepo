# Required public-service posture. The application enforces this to 0 too.
AUDIO_TOO_LLM_ENABLED=0

# Comma-separated website origins. Never use '*'.
KENN_CHAT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local-only runtime state; Audio_Too remains read-only.
KENN_CHAT_RUNTIME_DIR=.runtime
# Writable generated index location; the container image uses this outside Audio_Too.
KENN_CHAT_INDEX_DIR=.runtime/index
KENN_CHAT_ENGINE_TIMEOUT_SECONDS=30
KENN_CHAT_RATE_LIMIT_REQUESTS=30
KENN_CHAT_RATE_LIMIT_WINDOW_SECONDS=60
