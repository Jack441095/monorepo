{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kenn.local/schemas/kenn.evidence.v1.json",
  "title": "KENN versioned audio evidence packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "source", "captured_at_age_seconds", "facts", "limitations"],
  "properties": {
    "schema": { "const": "kenn.evidence.v1" },
    "source": {
      "type": "string",
      "enum": ["plugin_bus_snapshot", "mix_review_upload", "realtime_mix_comparison", "ableton_session_snapshot", "stem_masking_analysis", "audio_classification"]
    },
    "captured_at_age_seconds": { "type": ["number", "null"], "minimum": 0 },
    "observed_at_epoch": { "type": ["number", "null"] },
    "facts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "unit", "source", "confidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 128 },
          "value": { "type": ["number", "string", "boolean"] },
          "unit": { "type": "string", "maxLength": 32 },
          "source": { "type": "string", "minLength": 1, "maxLength": 64 },
          "confidence": { "type": "string", "minLength": 1, "maxLength": 32 }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 512 }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "current_for_diagnosis", "age_seconds", "max_current_age_seconds"],
      "properties": {
        "status": { "type": "string", "enum": ["current", "stale_or_unknown"] },
        "current_for_diagnosis": { "type": "boolean" },
        "age_seconds": { "type": ["number", "null"], "minimum": 0 },
        "max_current_age_seconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
