KENN_HOST=127.0.0.1
KENN_PORT=8090
KENN_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SLO_CLASSIFICATION_DB=

# Live backend selection. Keep osc for the bundled AbletonOSC route, or set
