<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shenrendao.kenn.companion</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>-u</string>
        <string><KENN_REPO_ROOT>/apps/backend/src/kenn/server.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string><KENN_REPO_ROOT></string>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>StandardOutPath</key>
    <string><USER_HOME>/Library/Logs/KENN/kenn_companion.log</string>
    <key>StandardErrorPath</key>
    <string><USER_HOME>/Library/Logs/KENN/kenn_companion_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>KENN_PORT</key>
        <string>8090</string>
        <key>KENN_USE_MLX</key>
        <string>1</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>PYTHONPATH</key>
        <string><KENN_REPO_ROOT>/apps/backend/src</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/Library/Frameworks/Python.framework/Versions/3.13/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
