# 本机 velvet_thunder Dashboard，例如 http://127.0.0.1:8080；留空则走 Vite 代理
API_URL=http://127.0.0.1:8080

# Mix Review 前缀：Dashboard 用 /api/admin
VITE_MIX_REVIEW_API_PREFIX=/api/admin

# true=Mock；false=真实接口
VITE_MIX_REVIEW_MOCK=false

# Jack Dashboard 密码（可选，无需登录留空）
VITE_MIX_REVIEW_DASHBOARD_PASSWORD=

# SLO classification UI. Mock mode never contacts KENN or SLO.
VITE_SLO_CLASSIFICATION_MOCK=true
# ready | empty | offline | error | malformed
VITE_SLO_CLASSIFICATION_MOCK_SCENARIO=ready
