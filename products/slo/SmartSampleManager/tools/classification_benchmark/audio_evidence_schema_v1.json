{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nitedsp.com/schemas/slo/audio-evidence/1.0.0",
  "title": "SLO Audio Evidence Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "content_id", "source_path", "identity", "family", "form", "attributes", "measurements", "metadata", "model_versions", "legacy"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "content_id": {"type": "string", "minLength": 1},
    "source_path": {"type": "string", "minLength": 1},
    "identity": {"$ref": "#/$defs/claim"},
    "family": {"$ref": "#/$defs/claim"},
    "form": {"$ref": "#/$defs/claim"},
    "attributes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/claim"}},
    "measurements": {"type": "object", "additionalProperties": {"$ref": "#/$defs/measurement"}},
    "metadata": {"type": "object"},
    "duplicate_group": {"type": "string"},
    "model_versions": {"type": "object", "additionalProperties": {"type": "string"}},
    "legacy": {"type": "object"}
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confidence", "source", "state", "alternatives"],
      "properties": {
        "value": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"type": "string"},
        "state": {"enum": ["observed", "predicted", "user", "unknown", "rejected"]},
        "alternatives": {
          "type": "array",
          "items": {
            "type": "array",
            "prefixItems": [{"type": "string", "minLength": 1}, {"type": "number", "minimum": 0, "maximum": 1}],
            "items": false
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "method", "valid"],
      "properties": {
        "value": {"type": "number"},
        "unit": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "valid": {"type": "boolean"}
      }
    }
  }
}
