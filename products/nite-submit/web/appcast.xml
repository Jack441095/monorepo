  <channel>
    <title>NITE Submit Updates</title>
    <link>https://www.nitedsp.co.uk/submit/appcast.xml</link>
    <description>Official release feed for NITE Submit.</description>
    <language>en</language>
    <item>
      <title>NITE Submit 1.0.0</title>
